{
  "name": "guni-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/generate.mjs && vite",
    "build": "node scripts/generate.mjs && tsc --noEmit && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:browser": "npm run build && node scripts/check-browser.mjs",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "prepare:social": "npm run build && node scripts/check-browser.mjs --social",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@phosphor-icons/core": "2.1.1",
    "markdown-it": "14.3.2",
    "prettier": "3.9.6",
    "puppeteer": "25.10.0",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
